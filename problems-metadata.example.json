{
  "_comment": [
    "Example Taiga problems-metadata for this image. One entry per inverse task.",
    "Replace `image` with your pushed tag (never `latest`).",
    "startup_command: publishes query_oracle / submit_answer / describe_oracle.",
    "Grading strategy on the Create Problem form must be `mcp` (not Agentic Grader,",
    "not Rubric Itemwise).",
    "required_tools is empty because this task needs only MCP oracle tools.",
    "The image and problem data are root-only; Taiga model tools run as uid 1000.",
    "augment_prompt_with_input_files must be false so mounted paths are not listed",
    "in the system prompt."
  ],
  "problem_set": {
    "owner": "rohit.ganti",
    "name": "inverse-tasks",
    "description": "Inverse tasks: recover a hidden cause by querying a budgeted oracle.",
    "version": "1.0.0",
    "required_resources": "2vcpu+6gib",
    "problems": [
      {
        "image": "<your-registry>/<your-org>/inverse-tasks:v1",
        "startup_command": "python -u /app/mcp_server/server.py",
        "id": "modular-black-box",
        "required_tools": [],
        "scratchpad": "allowed",
        "enabled_package_managers": [],
        "enable_anthropic_api": false,
        "domain_allowlist": [],
        "grading_strategy": {
          "type": "mcp",
          "weight": 1.0
        },
        "augment_prompt_with_input_files": false,
        "preloaded_files_mode": "replace",
        "setup_timeout_seconds": 60,
        "startup_timeout_seconds": 60,
        "tool_timeout_seconds": 30,
        "grading_timeout_seconds": 60,
        "container_runtime": "gvisor",
        "metadata": {
          "task_type": "inverse-task",
          "direction": "inverse",
          "domain": "Samples"
        }
      }
    ]
  }
}
