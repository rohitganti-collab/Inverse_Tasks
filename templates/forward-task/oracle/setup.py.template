"""System for <problem-id> — a FORWARD task. NOTHING HERE IS HIDDEN.

Ships to Taiga (Preloaded Files), same as an inverse task's oracle. The engine
does not special-case direction: the model's only tools are `query_oracle`,
`describe_oracle`, and `submit_answer`, so even a forward task must reach the
model through a declared probe surface. There is no file-serving tool.

Unlike an inverse task there is no secret to recover. `spec` discloses the
complete system definition. The difficulty lives in the METHOD-SELECTION
DECISION — the model picks the settings the computation runs under, and a naive
default silently produces a plausible but wrong number. See ../INSTRUCTIONS.md.

The engine builds a fresh Oracle() per attempt and calls `oracle.<action>(**params)`.

WHAT THE ENGINE DOES FOR YOU:
  * BUDGET is enforced by the engine — don't count calls yourself.
  * Only actions declared in ACTIONS are reachable.
  * Parameters are validated before they reach you.

WHAT YOU MUST DO:
  * Put ALL per-attempt state in __init__, never at class level.
  * SEED ANY RANDOMNESS (`random.Random(42)`) — Taiga needs reproducibility.
  * Never print.

WHY BUDGET A TASK WITH NOTHING HIDDEN: so the model cannot sweep every setting
and read off the value results converge to. Brute-forcing the sweep IS the method
decision — remove the budget and you have removed the task. Wide enough for a
deliberate convergence check, no wider.

`run` MUST NOT JUDGE. Return the observation and the settings used. Never
converged/unconverged, never a warning that a setting is coarse, never a residual
the model can threshold into a free answer. Recognising an inadequate setting is
the skill being tested.

Dependencies: standard library only unless the image already carries the package.
"""


class Oracle:
    """<one line: the system being computed forward>"""

    BUDGET = 12

    # A forward task has NO `_`-prefixed ground truth. If you are adding one,
    # you are writing an inverse task — use ../../inverse-task/ instead.

    ACTIONS = [
        {
            "name": "spec",
            "description": (
                "Return the complete system definition: geometry, parameters, "
                "conditions, and regime. Discloses everything."
            ),
            "params": {},
            "costs_budget": False,
        },
        {
            "name": "run",
            "description": (
                "Run the computation under settings you choose and return the "
                "resulting observation."
            ),
            "params": {
                "resolution": {
                    "type": "integer",
                    "description": "Discretisation resolution.",
                    "default": 8,
                },
                "method": {
                    "type": "string",
                    "description": "Which solver to use.",
                    "default": "<default-method>",
                },
            },
            "costs_budget": True,
        },
        {
            "name": "help",
            "description": "List available modes and remaining budget.",
            "params": {
                "question": {
                    "type": "string",
                    "description": "Unused; accepted for a uniform calling shape.",
                    "default": "",
                },
            },
            "costs_budget": False,
        },
    ]

    ANSWER_SCHEMA = {
        "type": "array",
        "length": 1,
        "item_types": ["number"],
        "description": "Describe the answer shape the model must submit.",
    }

    def __init__(self):
        self._used = 0

    # ------------------------------------------------------------- actions #
    def spec(self):
        """Free and complete. Withhold nothing about the system.

        Listing the available methods and the valid resolution range is fine.
        Calling any of them adequate, recommended, standard, or sufficient is a
        leak — that is the decision being tested.
        """
        return {
            "geometry": "<...>",
            "parameters": {},
            "boundary_conditions": {},
            "regime": "<...>",
            "available_methods": ["<method-a>", "<method-b>"],
            "resolution_range": [0, 0],
        }

    def run(self, resolution: int = 8, method: str = "<default-method>"):
        """Run the forward computation, honouring the settings given.

        It MUST genuinely depend on them: a coarse resolution has to return a
        different, wrong number, and it has to do so WITHOUT crashing or warning.
        A silent wrong answer is the trap; a loud one is a hint.
        """
        self._used += 1
        resolution = int(resolution)

        # REPLACE with the real computation. The placeholder is a stand-in for a
        # discretisation error that shrinks as resolution grows: it converges to
        # 42.0, and at the default resolution it is off by a full unit while
        # looking like a perfectly ordinary result.
        observation = 42.0 - 8.0 / max(resolution, 1)

        # Echo the settings back. Return no verdict on their adequacy.
        return {
            "observation": observation,
            "resolution": resolution,
            "method": str(method),
        }

    def help(self, question: str = ""):
        return {
            "description": "<one neutral line: what system this computes>",
            "modes": {
                "spec": "{} -> dict",
                "run": "{resolution: integer, method: string} -> dict",
                "help": "{} -> {description, modes, budget_remaining}",
            },
            "budget_remaining": self.BUDGET - self._used,
        }
